          "info": {
            "name": "List segments",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.omnisend.com/api/segments",
            "headers": [
              {
                "name": "Omnisend-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Page size (1-50)"
              },
              {
                "name": "after",
                "value": "",
                "type": "query",
                "description": "Cursor for next page (base64-encoded, obtained from previous response)"
              },
              {
                "name": "before",
                "value": "",
