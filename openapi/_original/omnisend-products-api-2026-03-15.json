      }
     },
     "description": "Product to replace",
     "required": true
    },
    "responses": {
     "200": {
      "description": "Product replaced successfully with the given ID",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ReplaceProductResponse"
        }
       }
      }
     },
     "400": {
      "description": "Validation failed",
      "content": {
